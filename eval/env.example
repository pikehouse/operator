# GCP Cloud Eval Configuration
#
# These values are populated automatically by ./scripts/gcp-setup.sh
# You can also set them manually if you prefer.
#
# Copy this file to the project root as .env:
#   cp eval/env.example .env

# --- Required: Your Anthropic API key ---
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# --- GCP Configuration (auto-populated by gcp-setup.sh) ---

# Your GCP project ID
GCP_PROJECT=your-gcp-project-id

# Cloud SQL settings
GCP_DB_TIER=db-f1-micro
GCP_DB_REGION=us-central1
GCP_DB_PRIMARY_ADDRESS=
GCP_DB_URL=
GCP_DB_CONNECTION_NAME=

# Database credentials (auto-generated if not set)
EVAL_DATABASE_PASSWORD=
EVAL_DATABASE_URL=

# --- Optional overrides ---

# Override the default zone for worker VMs (default: us-central1-a)
# GCP_ZONE=us-central1-a
